# Copy this file to .env and fill in your values
# cp .env.example .env

# Base URL of your Laravel API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api

# SMICEE backend host used by src/utils/apiPaths.js (no trailing slash, no /api suffix)
VITE_API_HOST=https://api-v2.smicee.com

# Chat WebSocket host, no trailing slash. Leave empty in production: chat is served behind the
# same domain, so it defaults to VITE_API_HOST with the wss:// scheme. Set it for local dev only.
VITE_CHAT_WS_HOST=

# App display name (shown in browser tab)
VITE_APP_NAME="Process Management"
VITE_SHOW_DEMO_ACCOUNTS=false
